---
order: 1
---

{{ text.curriculum.intro | renderContent: 'md' }}
{% for semester in curriculum %}
	{% comment %} Uses the key itself. {% endcomment %}
	<h2>{{ semester.first | capitalize }} semester</h2>
	<table>
		<tbody>
			{% for course in semester.last %}
				<tr>
					<td>
						{%- if course.number %}
							<p>{{ course.number }}</p>
						{% endif %}
						<p>{{ course.credits }} Credits</p>
					</td>
					<td>
						<a href="{{ links.catalog | append: course.number | remove: ' ' }}">{{ course.title }}</a>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endfor %}
{% comment %} Pass the links directly; global data not available in `render` (see #1541). {% endcomment %}
{{ text.curriculum.outro | renderContent: 'liquid,md', links }}
