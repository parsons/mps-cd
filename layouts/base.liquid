<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta
			content="initial-scale=1, width=device-width, viewport-fit=cover"
			name="viewport"
		>
		<title>{{ title }}</title>
	</head>
	<body>
		<nav>
			<ul>
				{% for eachPage in collections.page %}
					<li {%- if eachPage.url == page.url %} aria-current="page"{% endif -%}>
						<a href="{{ eachPage.url }}">{{ eachPage.data.title }}</a>
					</li>
				{% endfor %}
			</ul>
		</nav>
		{{ content }}
	</body>
</html>
