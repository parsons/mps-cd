<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta
			content="initial-scale=1, width=device-width, viewport-fit=cover"
			name="viewport"
		>
		<title>{{ title }}</title>
	</head>
	<body>
		<nav aria-labelledby="nav">
			<h2 id="nav">
				<a {%- if page.url == '/' %} aria-current="page"{% endif %} href="/">{{ programTitle }} <em>{{ concentration }}</em></a>
			</h2>
			<ul>
				{% for eachPage in collections.page %}
					<li>
						<a {%- if eachPage.url == page.url %} aria-current="page"{% endif %} href="{{ eachPage.url }}">
							{{ eachPage.data.title }}
						</a>
					</li>
				{% endfor %}
			</ul>
		</nav>
		{{ content }}
	</body>
</html>
