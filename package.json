{
	"dependencies": {
		"@11ty/eleventy": "4.0.0-alpha.7",
		"@11ty/eleventy-img": "^6.0.4",
		"js-yaml": "^4.2.0",
		"markdown-it": "^14.2.0",
		"sharp": "^0.35.1"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"onFail": "download",
			"version": ">=22.13.0"
		}
	},
	"packageManager": "pnpm@11.5.0",
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('_site', { recursive: true, force: true })\"",
		"build": "pnpm clean && eleventy",
		"serve": "pnpm clean && eleventy --serve --port=80 --incremental"
	},
	"type": "module"
}
