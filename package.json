{
	"dependencies": {
		"@11ty/eleventy-img": "^7.1.1",
		"@awesome.me/buildawesome": "4.0.0-alpha.12",
		"image-dimensions": "^2.6.0",
		"js-yaml": "^5.5.0",
		"markdown-it": "^15.0.3"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"onFail": "download",
			"version": "26"
		}
	},
	"lint-staged": {
		"*": "eslint --no-warn-ignored"
	},
	"packageManager": "pnpm@11.5.0",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"clean": "node -e \"require('fs').rmSync('_site', { recursive: true, force: true })\"",
		"build": "pnpm clean && buildawesome",
		"serve": "pnpm clean && buildawesome --serve --port=80 --incremental",
		"lint": "eslint . --fix"
	},
	"type": "module",
	"devDependencies": {
		"eslint": "^10.15.0",
		"eslint-plugin-yml": "^3.10.0",
		"lint-staged": "^17.6.2"
	}
}
