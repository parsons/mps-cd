{
	"dependencies": {
		"@11ty/eleventy-img": "^6.0.4",
		"@awesome.me/buildawesome": "4.0.0-alpha.8",
		"image-dimensions": "^2.5.1",
		"js-yaml": "^4.2.0",
		"markdown-it": "^14.2.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"onFail": "download",
			"version": ">=22.13.0"
		}
	},
	"packageManager": "pnpm@11.5.0",
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('_site', { recursive: true, force: true })\"",
		"build": "pnpm clean && buildawesome",
		"serve": "pnpm clean && buildawesome --serve --port=80 --incremental",
		"lint": "eslint . --fix"
	},
	"type": "module",
	"devDependencies": {
		"eslint": "^10.5.0",
		"eslint-plugin-yml": "^3.4.0"
	}
}
