{
	"dependencies": {
		"@11ty/eleventy": "4.0.0-alpha.7"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"onFail": "download",
			"version": ">=22.13.0"
		}
	},
	"packageManager": "pnpm@11.5.0",
	"scripts": {
		"clean": "node -e \"import('fs').then(fs => fs.rmSync('_site', { recursive: true, force: true }))\"",
		"build": "pnpm clean && eleventy",
		"serve": "pnpm clean && eleventy --serve --port=80 --incremental"
	},
	"type": "module"
}
