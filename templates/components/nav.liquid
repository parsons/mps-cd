<nav aria-labelledby="nav">
	<h2 id="nav">
		<a {%- if page.url == '/' %} aria-current="page"{% endif %} href="{{ '/' | url }}">{{ programTitle }} <em>{{ concentration }}</em></a>
	</h2>
	<ul>
		{% assign pages = collections.all | where: 'data.order' | sort: 'data.order' %}
		{% for eachPage in pages %}
			<li>
				<a {%- if eachPage.url == page.url %} aria-current="page"{% endif %} href="{{ eachPage.url | url }}">{{ eachPage.data.title }}</a>
			</li>
		{% endfor %}
	</ul>
</nav>
