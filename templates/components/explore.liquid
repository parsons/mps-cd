<aside>
	<h2>{{ text.explore.heading }}</h2>
	{% for cohort in projects %}
		<details {%- if forloop.first %} open{% endif %}>
			<summary>{{ cohort.year }}</summary>
			<ul>
				{% assign sorted = cohort.projects | sort_natural: 'title' %}
				{% for project in sorted %}
					<li>
						<hgroup>
							<h3>
								<a {%- if project.url %} href="{{ project.url }}"{% endif %}>
									{{- project.title -}}
								</a>
							</h3>
							<address>
								<a {%- if project.student.url %} href="{{ project.student.url }}"{% endif %}>
									{{- project.student.first }} {{ project.student.last -}}
								</a>
							</address>
						</hgroup>
						{% if project.description %}
							<section>
								{{ project.description | markdown }}
							</section>
						{% endif %}
						<figure>
							{% for image in project.images %}
								{% resizedImg image 120 %}
							{% endfor %}
						</figure>
					</li>
				{% endfor %}
			</ul>
		</details>
	{% endfor %}
	{{ text.explore.license | markdown }}
</aside>
