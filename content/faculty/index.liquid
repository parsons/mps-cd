<h1>{{ title }}</h1>
<ul>
	{% assign sortedCurrent = faculty.current | sort: 'last' %}
	{% for instructor in sortedCurrent %}
		<li>
			<a href="{{ instructor.url }}">{{ instructor.first }} {{ instructor.last }}</a>
		</li>
	{% endfor %}
</ul>
<details>
	<summary>Previous {{ title | downcase }}</summary>
	<ul>
		{% assign sortedPrevious = faculty.previous | sort: 'last' %}
		{% for instructor in sortedPrevious %}
			<li>
				<a href="{{ instructor.url }}">{{ instructor.first }} {{ instructor.last }}</a>
			</li>
		{% endfor %}
	</ul>
</details>
<h2>Visiting Critics</h2>
<p>In addition to our core faculty, the MPS Communication Design program hosts a variety of workshops, lectures, and reviews with a wide range of external critics.</p>
<ul>
	{% assign sortedGuests = guests | sort: 'last' %}
	{% for guest in sortedGuests %}
		<li>
			<p>{{ guest.first }} {{ guest.last }}</p>
		</li>
	{% endfor %}
</ul>
